# PostgreSQL database connection string
# Example: DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ppt_agent"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ppt_agent"

API_PORT=4000
WEB_PORT=5173
# FastAPI 对外；迁移期 Node 数据/渲染侧车只监听本机 4010
LEGACY_API_PORT=4010
LEGACY_API_URL="http://127.0.0.1:4010"

# 主 SmartDiagram Knowledge Gateway。Node 只保存资料引用，不复制原件或解析全文。
MATERIAL_GATEWAY_URL="http://127.0.0.1:8000"
AUTH_SERVICE_URL="http://127.0.0.1:8000"
# 生产环境必须替换，并确保 Python/Node 两个 PPT 服务使用同一值。
# Node/Python 内部信任边界；部署前必须替换为至少 32 字节随机值，两个服务使用同一值。
PPT_INTERNAL_API_SECRET="replace-with-a-long-random-value"
PPT_GUEST_PROJECT_TTL_SECONDS="86400"
# 单次事实提取的上下文字符预算；长文档会按证据块分批扫描。
MATERIAL_CONTEXT_BATCH_CHARS=48000

# ---------------------------------------------------------------------------
# 演讲稿配音 / 视频导出
# API Key 只由后端读取，不要放到 VITE_* 变量。视频合成需要本机 ffmpeg。
# ---------------------------------------------------------------------------
TTS_API_KEY="tts-your-api-key"
TTS_API_BASE_URL="https://tts.zlcggb.com"
TTS_DEFAULT_MODEL="gemini-3.1-flash-tts-preview"
TTS_DEFAULT_VOICE="Kore"
TTS_LANGUAGE_CODE="cmn-CN"
# 批量配音并发数，服务端会限制在 1–5，建议默认 3。
TTS_CONCURRENCY=3

GRAPH_MAX_CONCURRENCY=3
GRAPH_RECURSION_LIMIT=32
# GRAPH_CHECKPOINT_PATH="./storage/langgraph/checkpoints.sqlite"

# ---------------------------------------------------------------------------
# AI Provider
#   mock              = 无 Key 可演示
#   openai-compatible = OpenAI 兼容网关（推荐：你现有的 unilumin-gtm Key）
#   gemini            = Google 官方 Gemini API
# ---------------------------------------------------------------------------
AI_PROVIDER="openai-compatible"

# OpenAI 兼容网关（你的密钥走这里）
OPENAI_COMPATIBLE_API_KEY="sk-proj-xxx"
OPENAI_COMPATIBLE_BASE_URL="https://api.unilumin-gtm.xyz/v1"

# 双模型角色（LangGraph 多智能体里的不同 Node，不是同一次调用混用）
# MODEL        = 检索 / 初稿 / 大纲（建议更快更便宜，如 gemini-3.5-flash / kimi-for-coding-highspeed）
# DESIGN_MODEL = 设计出图 SVG（可用更强 agent，如 gemini-3-flash-agent / kimi-k3）
OPENAI_COMPATIBLE_MODEL="gemini-3.5-flash"
OPENAI_COMPATIBLE_DESIGN_MODEL="gemini-3-flash-agent"
OPENAI_COMPATIBLE_TEMPERATURE=1

# ---------------------------------------------------------------------------
# 思考深度 / reasoning_effort（K3 等模型有效；不传会默认 max，导致耗时/Token 都很高）
#   取值：low | high | max | none（none 表示关闭思考）
#   优先级：阶段专用 > DESIGN/MAIN > EFFORT > 默认 low
#   字段名：unilumin-gtm K3 用 reasoning_effort；别的网关可能用 effort
# ---------------------------------------------------------------------------
# 默认字段名
OPENAI_COMPATIBLE_EFFORT_FIELD=reasoning_effort
# 默认低思考，避免默认 max
OPENAI_COMPATIBLE_EFFORT=low
# 通用模型（检索/大纲/策划）与设计模型（IR/SVG）可分别设置
# OPENAI_COMPATIBLE_MAIN_EFFORT=low
# OPENAI_COMPATIBLE_DESIGN_EFFORT=low
# 阶段专用：可覆盖以上
# OPENAI_COMPATIBLE_RESEARCH_EFFORT=high
# OPENAI_COMPATIBLE_OUTLINE_EFFORT=high
# OPENAI_COMPATIBLE_PLAN_EFFORT=high
# OPENAI_COMPATIBLE_SVG_EFFORT=low
# OPENAI_COMPATIBLE_SEARCH_EFFORT=low
# OPENAI_COMPATIBLE_FACTS_EFFORT=low
# OPENAI_COMPATIBLE_BRIEF_EFFORT=low
# 兼容网关若把多个 SSE event 合并到同一网络包，按原 event 顺序渐进转发的目标时长（毫秒）
OPENAI_COMPATIBLE_STREAM_REPLAY_MS=2600

# 按页 fan-out 并发（类 grok-build 多子代理 + wait_all；默认 3，最大 8）
SEARCH_CONCURRENCY=3
PLAN_CONCURRENCY=3
# AI_CONCURRENCY=3

# 编排后端（默认 native = 本仓 stageGraph + parallelMap）
# ORCHESTRATION_BACKEND=native
# 实验：grok-sidecar 骨架（不 spawn；mapPages 仍回退 native，除非 GROK_SIDECAR_STRICT_MAP=1）
# ORCHESTRATION_BACKEND=grok-sidecar
# GROK_SIDECAR_BIN="/usr/local/bin/grok"
# GROK_SIDECAR_STRICT_MAP=0

# 兼容旧变量名（MODEL 未设时才回退到 DEEP_THINK_LLM）
# TRADINGAGENTS_LLM_BACKEND_URL="https://api.unilumin-gtm.xyz/v1"
# TRADINGAGENTS_DEEP_THINK_LLM="gemini-3-flash-agent"

# Google 官方 Gemini（仅 AI_PROVIDER=gemini 时需要）
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.1-flash-lite"
# GEMINI_DESIGN_MODEL="gemini-3.5-flash"
# GEMINI_PROXY_URL="http://127.0.0.1:7892"

# ---------------------------------------------------------------------------
# 资料检索
#   ai-knowledge = 未联网的模型知识整理（不会再伪造 URL）
#   tavily       = 真实联网检索，并生成可供初稿使用的资料提炼稿
# 未显式设置时：有 TAVILY_API_KEY 自动用 tavily，否则用 ai-knowledge。
# ---------------------------------------------------------------------------
RESEARCH_PROVIDER="ai-knowledge"
# TAVILY_API_KEY="tvly-xxx"
# TAVILY_SEARCH_DEPTH="advanced"
# TAVILY_MAX_RESULTS=6
# TAVILY_API_URL="https://api.tavily.com/search"
