{
  "name": "@ppt-agent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:intent": "node --import tsx --test src/lib/intentContext.test.ts",
    "test:security": "node --import tsx --test src/lib/exportAccess.test.ts src/lib/pptAccess.test.ts src/lib/pptAuthorization.test.ts src/lib/pptPrincipal.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.0.4",
    "@ppt-agent/agents": "workspace:*",
    "@ppt-agent/ppt-renderer": "workspace:*",
    "@ppt-agent/slide-ir": "workspace:*",
    "@ppt-agent/shared": "workspace:*",
    "@prisma/client": "^6.16.0",
    "fastify": "^5.2.1",
    "music-metadata": "11.14.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
