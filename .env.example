# =============================================================================
# SmartDiagram — 统一环境变量（唯一配置文件）
#
# 复制：cp .env.example .env ，按分类填入密钥。
# 可选：apps/<service>/.env 仅用于本机临时覆盖（会覆盖同名键）。
#
# 两套数据库不要混用：
#   DIAGRAM_DATABASE_URL → 图表库 smartdiagram
#   PPT_DATABASE_URL / DATABASE_URL → PPT 库 ppt_agent（Prisma 约定读 DATABASE_URL）
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Platform / Deploy
# -----------------------------------------------------------------------------
# DB_PASSWORD：首次部署（无 PostgreSQL 数据卷）时 deploy 脚本会自动生成并同步双库 URL；已有数据卷则保留原密码。
DB_PASSWORD=smartdiagram_secret
# PPT 内部密钥：deploy 脚本会自动生成（≥32 字节），无需手填。
PPT_INTERNAL_API_SECRET=replace-with-a-long-random-value
GATEWAY_PORT=9237
CN_MIRROR=false
# UV_IMAGE=ghcr.1ms.run/astral-sh/uv:0.10.5
# UV_PYTHON_IMAGE=ghcr.1ms.run/astral-sh/uv:python3.13-bookworm-slim

# -----------------------------------------------------------------------------
# 2) Diagram — apps/api-diagram（图表后端）
# -----------------------------------------------------------------------------
DIAGRAM_DATABASE_URL=postgresql+asyncpg://postgres:smartdiagram_secret@localhost:5432/smartdiagram
REDIS_URL=redis://localhost:6379/0

# LLM（OpenAI 兼容）
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_ID=gemini-2.5-flash
MAX_TOKENS=16384
TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_DRAWIO_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=0
RUNTIME_INPUT_COST_PER_1K=0.0015
RUNTIME_OUTPUT_COST_PER_1K=0.009

# Vertex AI（可选）
USE_VERTEX_AI=false
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=gcp-credentials.json

# 智能模型路由（取消注释可覆盖全局 MODEL_ID）
# MODEL_ROUTE_ROUTER=gemini-2.5-flash
# MODEL_ROUTE_GENERAL=gemini-2.5-flash
# MODEL_ROUTE_EXCALIDRAW=gemini-2.5-flash
# MODEL_ROUTE_MERMAID=gemini-2.5-flash
# MODEL_ROUTE_FLOW=gemini-2.5-flash
# MODEL_ROUTE_DRAWIO=gemini-2.5-flash
# MODEL_ROUTE_CHARTS=gemini-2.5-flash
# MODEL_ROUTE_INFOGRAPHIC=gemini-2.5-flash
# MODEL_ROUTE_MINDMAP=gemini-2.5-flash

# Auth / CAPTCHA（生产默认关闭本地测试账号；本机开发需要时显式改为 true）
AUTH_LOCAL_LOGIN_ENABLED=false
AUTH_REGISTRATION_ENABLED=true
AUTH_SESSION_SECRET=smartdiagram-dev-session-secret-change-me
AUTH_SESSION_TTL_SECONDS=43200
AUTH_DEMO_USER_EMAIL=user@smartdiagram.local
AUTH_DEMO_USER_PASSWORD=user123456
AUTH_DEMO_ADMIN_EMAIL=admin@smartdiagram.local
AUTH_DEMO_ADMIN_PASSWORD=admin123456
# 平台超管种子邮箱（逗号分隔）— 仅在启动/迁移时写入 user_platform_roles 表；运行时权限以数据库为准
PLATFORM_ADMIN_EMAILS=
AUTH_SHOW_DEMO_PRESETS=false
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# 统一访客会话（Diagram + PPT 共用 Bearer；生产建议 GUEST_CAPTCHA_REQUIRED=true + API_ORIGIN_CHECK_ENABLED=true）
GUEST_SESSION_ENABLED=true
GUEST_SESSION_TTL_SECONDS=86400
GUEST_CAPTCHA_REQUIRED=false
GUEST_AI_MAX_USES=5
GUEST_AI_MAX_USES_PER_IP=20
GUEST_AI_WINDOW_SECONDS=86400
API_ORIGIN_CHECK_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ALTCHA_HMAC_KEY=smartdiagram-dev-altcha-hmac-key-change-me
ALTCHA_ALGORITHM=SHA-256
ALTCHA_MAX_NUMBER=100000

# Object storage / knowledge / runtime（可按需改）
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=
OBJECT_STORAGE_HTTP_TIMEOUT_SECONDS=30
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
EXPORT_CONFIRMATION_REQUIRED_FORMATS=pdf,pptx
KNOWLEDGE_INGESTION_REDIS_QUEUE=smartdiagram:knowledge:ingestion
EXPORT_REDIS_QUEUE=smartdiagram:queue:exports
WORKER_JOB_LOCK_TTL_SECONDS=1800
# 生产 Docker（--with-worker）由 compose 覆盖 REDIS_URL / RUNTIME_RATE_LIMIT_BACKEND=redis
KNOWLEDGE_VECTOR_BACKEND=local_db
KNOWLEDGE_VECTOR_DIMENSIONS=384
KNOWLEDGE_VECTOR_FALLBACK_TO_LOCAL=true
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=smartdiagram_knowledge
QDRANT_TIMEOUT_SECONDS=30
KNOWLEDGE_SECURITY_POLICY_MODE=rule
KNOWLEDGE_SECURITY_BLOCK_SEVERITY=high
KNOWLEDGE_SECURITY_TRUSTED_TERMS="模板,示例,培训,规范,政策,流程,quote process"
RUNTIME_RATE_LIMIT_PER_MINUTE=30
# 本地开发可用 memory；Docker / 多实例生产建议 redis
RUNTIME_RATE_LIMIT_BACKEND=memory
RUNTIME_RATE_LIMIT_REDIS_FAIL_OPEN=false
RUNTIME_MAX_ESTIMATED_TOKENS=32000
RUNTIME_DEGRADE_TOKEN_THRESHOLD=18000
RUNTIME_MAX_STREAM_EVENTS=2500
RUNTIME_MAX_AGENT_REPEATS=12
TENANT_DEFAULT_MONTHLY_COST_LIMIT=25.0
TENANT_DEFAULT_MONTHLY_TOKEN_LIMIT=5000000
TENANT_BUDGET_HARD_LIMIT=true
USAGE_ROLLUP_SCHEDULER_ENABLED=false
USAGE_ROLLUP_REFRESH_ON_STARTUP=false
USAGE_ROLLUP_REFRESH_INTERVAL_SECONDS=900
WORKER_STALE_JOB_TIMEOUT_SECONDS=1800
WORKER_STALE_JOB_ACTION=requeue
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
MODEL_USAGE_PRICING_JSON={"gpt-5.3-codex-spark":{"input":18,"output":72,"cache":9,"currency":"CNY"},"gpt-5.6-sol":{"input":18,"output":72,"cache":9,"currency":"CNY"},"gpt-5.6-terra":{"input":18,"output":72,"cache":9,"currency":"CNY"},"gemini-3.6-flash-high":{"input":0.5,"output":2,"cache":0.125,"currency":"CNY"}}

# -----------------------------------------------------------------------------
# 3) PPT — apps/api-ppt + apps/service-ppt-renderer
# -----------------------------------------------------------------------------
PPT_DATABASE_URL="postgresql://postgres:smartdiagram_secret@127.0.0.1:5432/ppt_agent?schema=public"
# Prisma / Node 约定变量；请与 PPT_DATABASE_URL 保持相同值
DATABASE_URL="postgresql://postgres:smartdiagram_secret@127.0.0.1:5432/ppt_agent?schema=public"

API_PORT=4000
WEB_PORT=5173
LEGACY_API_PORT=4010
LEGACY_API_URL="http://127.0.0.1:4010"
MATERIAL_GATEWAY_URL="http://127.0.0.1:8000"
AUTH_SERVICE_URL="http://127.0.0.1:8000"
USAGE_LEDGER_URL="http://127.0.0.1:8000"
PPT_GUEST_PROJECT_TTL_SECONDS="86400"
MATERIAL_CONTEXT_BATCH_CHARS=48000

TTS_API_KEY="tts-your-api-key"
TTS_API_BASE_URL="https://tts.zlcggb.com"
TTS_DEFAULT_MODEL="gemini-3.1-flash-tts-preview"
TTS_DEFAULT_VOICE="Kore"
TTS_LANGUAGE_CODE="cmn-CN"
TTS_CONCURRENCY=3
# 可选：覆盖 FFmpeg 路径。留空则自动从 PATH 探测；Docker 部署镜像已 apt 安装 ffmpeg。
# FFMPEG_PATH="/opt/homebrew/bin/ffmpeg"

GRAPH_MAX_CONCURRENCY=3
GRAPH_RECURSION_LIMIT=32

# AI：mock | openai-compatible | gemini
AI_PROVIDER="openai-compatible"
OPENAI_COMPATIBLE_API_KEY="sk-proj-xxx"
OPENAI_COMPATIBLE_BASE_URL="https://api.unilumin-gtm.xyz/v1"
OPENAI_COMPATIBLE_MODEL="gemini-3.5-flash"
OPENAI_COMPATIBLE_DESIGN_MODEL="gemini-3-flash-agent"
OPENAI_COMPATIBLE_TEMPERATURE=1
OPENAI_COMPATIBLE_EFFORT_FIELD=reasoning_effort
OPENAI_COMPATIBLE_EFFORT=low
OPENAI_COMPATIBLE_STREAM_REPLAY_MS=2600
SEARCH_CONCURRENCY=3
PLAN_CONCURRENCY=3
RESEARCH_PROVIDER="ai-knowledge"
# TAVILY_API_KEY="tvly-xxx"
# GEMINI_API_KEY=""
# GEMINI_PROXY_URL="http://127.0.0.1:7892"
