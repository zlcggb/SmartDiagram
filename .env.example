# Docker Compose deployment settings.
#
# IMPORTANT: DB_PASSWORD is used when PostgreSQL initializes the volume for the
# first time. On an existing server, keep using the original value; changing
# this file alone does not change the password stored inside PostgreSQL.
DB_PASSWORD=replace-with-a-long-random-password-before-first-deploy
GATEWAY_PORT=80

# Docker build mirror selection: true / false. deploy.sh uses auto detection
# unless --cn or --no-cn is passed explicitly.
CN_MIRROR=false
