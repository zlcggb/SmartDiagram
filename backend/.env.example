# SmartDiagram — Environment Configuration
# Copy this to .env and fill in your values

# LLM Provider (any OpenAI-compatible API)
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_ID=gpt-4o

# LLM Parameters
MAX_TOKENS=16384
TEMPERATURE=0.3

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartdiagram

# Observability (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
