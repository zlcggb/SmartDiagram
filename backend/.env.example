# SmartDiagram — Environment Configuration
# Copy this to .env and fill in your values

# LLM Provider (any OpenAI-compatible API)
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_ID=gemini-2.5-flash

# LLM Parameters
MAX_TOKENS=16384
TEMPERATURE=0.3

# ── Google Cloud Vertex AI (Optional for utilizing GCP Credits) ──
USE_VERTEX_AI=false
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=gcp-credentials.json

# ── 智能模型路由 ──
MODEL_ROUTE_ROUTER=gemini-2.5-flash
MODEL_ROUTE_GENERAL=gemini-2.5-flash
MODEL_ROUTE_EXCALIDRAW=gemini-2.5-flash
MODEL_ROUTE_MERMAID=gemini-2.5-flash
MODEL_ROUTE_FLOW=gemini-2.5-flash
MODEL_ROUTE_DRAWIO=gemini-2.5-flash
MODEL_ROUTE_CHARTS=gemini-2.5-flash
MODEL_ROUTE_INFOGRAPHIC=gemini-2.5-flash
MODEL_ROUTE_MINDMAP=gemini-2.5-flash

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartdiagram

# Observability (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
